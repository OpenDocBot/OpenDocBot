    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "officeparser": "7.8.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
