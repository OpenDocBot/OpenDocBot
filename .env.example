# OpenDocBot self-hosted configuration.
# Used by Docker Compose and by `make serve` for the Node path.
# Copy to .env, or let ./setup.sh create it for you.

# Host port mapped to the container's HTTPS listener. Office expects 443 for
# real users. If you change it, the manifest must include the same port.
OPENDOCBOT_HTTPS_PORT=443

# Certificates live in certs/addin.crt and certs/addin-key.pem. Docker Compose
# mounts that directory at /certs. Node reads the same files from the repository
# root. Set these only to override the default paths or pass PEM/base64 content.
# TLS_CERT=certs/addin.crt
# TLS_KEY=certs/addin-key.pem

# Key that encrypts stored refresh tokens. Leave empty to auto-generate one next
# to the session store (0600). If you set it yourself, use a high-entropy value
# such as `openssl rand -base64 32`, not a human passphrase.
OPENDOCBOT_SESSION_SECRET=

# Where sessions and encrypted refresh tokens are stored. Must survive restarts.
# Docker Compose sets /data/opendocbot-sessions.json automatically. Node
# defaults to ~/.opendocbot-sessions.json. Uncomment only to override.
# OPENDOCBOT_SESSION_STORE=/data/opendocbot-sessions.json

# Managed configuration (optional). Force a subset of the add-in settings for
# every user of this instance. Provide the forced keys as a JSON object; keys
# you omit stay user-configurable. The add-in fetches it same-origin from
# /app-config.json. Leave empty to stay unmanaged.
#   OPENDOCBOT_MANAGED_CONFIG={"apiKey":"sk-...","baseUrl":"https://api.openai.com/v1","model":"gpt-5.6-luna"}
OPENDOCBOT_MANAGED_CONFIG=
# Alternative to the inline value: path to a JSON file with the forced keys.
OPENDOCBOT_MANAGED_CONFIG_FILE=

# Require SSO for a managed config. Defaults to true: the server refuses to
# start if OPENDOCBOT_MANAGED_CONFIG is set without OIDC, because the managed
# config may contain credentials. Set to false only for a trusted/internal
# deployment that knowingly serves an unauthenticated (non-credential) config.
OPENDOCBOT_MANAGED_REQUIRE_SSO=true

# Single sign-on (optional, self-hosted only). When set, /app-config.json
# requires a valid session and the add-in shows a sign-in gate. The app is
# registered at the identity provider (OIDC authorization code + PKCE).
# Redirect URI to register: https://<your-host>/auth/callback
OPENDOCBOT_OIDC_ISSUER=
OPENDOCBOT_OIDC_CLIENT_ID=
OPENDOCBOT_OIDC_CLIENT_SECRET=
# Space-separated; default openid profile email offline_access.
OPENDOCBOT_OIDC_SCOPES=
# Comma-separated group object IDs. Empty = any authenticated user.
OPENDOCBOT_OIDC_ALLOWED_GROUPS=
# Name of the ID token claim that carries group membership. Default: groups.
# Set to memberOf or a namespaced claim for providers that use another name.
OPENDOCBOT_OIDC_GROUPS_CLAIM=
# Override the computed redirect URI (needed behind a proxy).
OPENDOCBOT_OIDC_REDIRECT_URI=

# Developer tests only. These are not used by the self-hosted app.
# Microsoft Foundry: when all three are set, the Foundry integration tests run
# against the real deployment. BEDROCK_API_KEY enables the free Bedrock
# discovery tests; BEDROCK_LIVE_INFERENCE=1 also runs real inference.
FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=
FOUNDRY_DEPLOYMENT=
BEDROCK_API_KEY=
BEDROCK_REGION=
BEDROCK_MODEL=
