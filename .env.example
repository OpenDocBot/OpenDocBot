# OpenDocBot self-hosted configuration (docker compose)
# Copy to .env and fill in your values.

# Host port the add-in is served on. Office loads it from this address.
# Keep 3000 for the localhost manifest; change for production.
OPENDOCBOT_HOST_PORT=3000

# Container internal listen port and bind address. These match the Dockerfile
# defaults and rarely need changing. All OpenDocBot services use port 3000.
PORT=3000
HOST=0.0.0.0

# Directory (inside the container) holding the built app to serve.
DIST_DIR=/app/dist

# HTTPS is REQUIRED by Office. Provide the certificate and private key as
# base64-encoded PEM. Generate from your cert/key files with:
#   base64 -w0 /path/to/cert.pem
#   base64 -w0 /path/to/key.pem
TLS_CERT=
TLS_KEY=
