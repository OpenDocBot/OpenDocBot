# OpenDocBot self-hosted configuration (docker compose)
# Copy to .env and fill in your values.

# Host port the add-in is served on. Office loads it from this address.
# Keep 3000 for the localhost manifest; change for production.
OPENDOCBOT_HOST_PORT=3000

# Container internal listen port and bind address. These match the Dockerfile
# defaults and rarely need changing. All OpenDocBot services use port 3000.
PORT=3000
HOST=0.0.0.0

# Directory (inside the container) holding the built app to serve.
DIST_DIR=/app/dist

# HTTPS is REQUIRED by Office. Provide the certificate and private key as
# base64-encoded PEM. Generate from your cert/key files with:
#   base64 -w0 /path/to/cert.pem
#   base64 -w0 /path/to/key.pem
TLS_CERT=
TLS_KEY=

# Managed configuration (optional). Force a subset of the add-in settings for
# every user of this instance. Provide the forced keys as a JSON object; keys
# you omit stay user-configurable. The add-in fetches it same-origin from
# /app-config.json. Leave empty to stay unmanaged.
#   OPENDOCBOT_MANAGED_CONFIG={"apiKey":"sk-...","baseUrl":"https://api.openai.com/v1","model":"gpt-5.6-luna"}
OPENDOCBOT_MANAGED_CONFIG=
# Alternative to the inline value: path to a JSON file with the forced keys.
OPENDOCBOT_MANAGED_CONFIG_FILE=

# Require SSO for a managed config. Defaults to true: the server refuses to
# start if OPENDOCBOT_MANAGED_CONFIG is set without OIDC, because the managed
# config may contain credentials. Set to false only for a trusted/internal
# deployment that knowingly serves an unauthenticated (non-credential) config.
OPENDOCBOT_MANAGED_REQUIRE_SSO=true

# Single sign-on (optional, self-hosted only). When set, /app-config.json
# requires a valid session and the add-in shows a sign-in gate. The app is
# registered at the identity provider (OIDC authorization code + PKCE).
# Redirect URI to register: https://<your-host>/auth/callback
OPENDOCBOT_OIDC_ISSUER=
OPENDOCBOT_OIDC_CLIENT_ID=
OPENDOCBOT_OIDC_CLIENT_SECRET=
# Space-separated; default openid profile email offline_access.
OPENDOCBOT_OIDC_SCOPES=
# Comma-separated group object IDs. Empty = any authenticated user.
OPENDOCBOT_OIDC_ALLOWED_GROUPS=
# Name of the ID token claim that carries group membership. Default: groups.
# Set to memberOf or a namespaced claim for providers that use another name.
OPENDOCBOT_OIDC_GROUPS_CLAIM=
# Override the computed redirect URI (needed behind a proxy).
OPENDOCBOT_OIDC_REDIRECT_URI=

# Where sessions (and encrypted refresh tokens) are stored. Must survive
# restarts; the Docker image mounts a volume at /data. This is a single-instance
# store: running several replicas needs a shared store instead.
OPENDOCBOT_SESSION_STORE=/data/opendocbot-sessions.json
# Key that encrypts stored refresh tokens. Leave empty to auto-generate a strong
# 32-byte key next to the session store (0600). If you set it yourself, use a
# high-entropy value (e.g. `openssl rand -base64 32`), not a human passphrase.
OPENDOCBOT_SESSION_SECRET=

# Microsoft Foundry (optional). Only used by the live provider integration
# tests (src/__tests__/providers/integration.test.ts). When all three are set,
# the Foundry suite runs against the real deployment. The base URL may be any
# resource URL (the root, /models, or a full /openai/v1/chat/completions URL);
# it is normalized to the v1 base. The model is your deployment name.
FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=
FOUNDRY_DEPLOYMENT=

# Amazon Bedrock (optional). Only used by the live Bedrock tests
# (src/__tests__/providers/bedrockLive.test.ts). With BEDROCK_API_KEY set, the
# free control-plane discovery tests run; set BEDROCK_LIVE_INFERENCE=1 to also
# run real inference (costs money). BEDROCK_REGION defaults to us-east-1 and
# BEDROCK_MODEL is the model used for the inference tests.
BEDROCK_API_KEY=
BEDROCK_REGION=
BEDROCK_MODEL=
